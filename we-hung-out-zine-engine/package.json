{
  "name": "we-hung-out-zine-engine",
  "version": "0.1.0",
  "description": "Deterministic layout engine + print-ready PDF renderer for the 'We hung out' zine product. Turns 8 editorial page specs into a single foldable 8-page zine sheet.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "demo": "node demo/generate.js",
    "demo:ai": "node demo/runAIPipeline.js",
    "build:web": "esbuild src/browser/entry.js --bundle --minify --format=iife --global-name=ZineEngine --platform=browser --outfile=web/zine-engine.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.45.0",
    "jimp": "^1.6.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
